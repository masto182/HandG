{
  "name": "@retail-example/backend",
  "version": "0.0.2",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "typecheck": "tsc --noEmit",
    "test:integration:http": "node integration-tests/run-http.mjs",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:integration": "node integration-tests/run-http.mjs",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:unit:coverage": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests --coverage --coverageReporters=text-summary",
    "shipengine:list-carriers": "medusa exec ./src/scripts/shipengine-list-carriers.ts",
    "scrape:untappd": "npx tsx scripts/scrape-untappd-images.ts",
    "staging:sync": "npx tsx scripts/staging-image-sync.ts",
    "staging:scrape": "npx tsx scripts/staging-image-sync.ts --scrape-only",
    "staging:upload": "npx tsx scripts/staging-image-sync.ts --upload-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1038.0",
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/admin-shared": "2.17.2",
    "@medusajs/caching": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/dashboard": "2.17.2",
    "@medusajs/draft-order": "2.17.2",
    "@medusajs/file-s3": "^2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/js-sdk": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@medusajs/ui": "4.1.19",
    "@react-email/components": "^0.0.30",
    "@react-email/render": "^1.4.0",
    "@retail-example/shared-types": "workspace:*",
    "@sentry/node": "^8.55.0",
    "@tanstack/react-query": "5.64.2",
    "csv-parse": "^6.2.1",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.58.0",
    "pg": "^8.20.0",
    "rate-limiter-flexible": "^11.1.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.4",
    "resend": "^6.12.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/genai": "^2.8.0",
    "@google/generative-ai": "^0.24.1",
    "@medusajs/test-utils": "2.17.2",
    "pg-god": "^1.0.12",
    "@playwright/test": "^1.59.1",
    "@react-email/ui": "6.4.0",
    "@swc/core": "^1.5",
    "@swc/jest": "^0.2",
    "@types/dotenv": "^8.2.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "prop-types": "^15.8.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rebrowser-playwright": "^1.52.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.13.0"
  },
  "packageManager": "pnpm@11.13.0"
}
