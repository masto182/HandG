{
  "name": "retail-example",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:start": "./dev.sh start",
    "dev:stop": "./dev.sh stop",
    "dev:restart": "./dev.sh restart",
    "dev:status": "./dev.sh status",
    "dev:logs": "./dev.sh logs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.13.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/storefront/**/*.{ts,tsx}": [
      "pnpm --filter storefront exec eslint --fix"
    ]
  }
}
