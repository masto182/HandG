# Staging env — copy to /opt/hopsandglory-staging/.env.staging on the VM.
# Generate secrets with: openssl rand -hex 32

# ---- Domain ----
PRIMARY_DOMAIN=staging.hopsandglory.au

# ---- Postgres ----
# docker-compose.prod.yml derives DATABASE_URL from these (DB_USER:DB_PASSWORD@postgres:5432/DB_NAME)
# and injects it into the backend service, so DATABASE_URL is NOT needed here.
DB_USER=medusa
DB_PASSWORD=REPLACE_openssl_rand_hex_32
DB_NAME=medusa

# ---- MeiliSearch ----
# REDIS_URL and MEILI_HOST are injected by docker-compose.prod.yml; only the key is needed here.
MEILI_MASTER_KEY=REPLACE_openssl_rand_hex_32

# ---- Auth / secrets ----
JWT_SECRET=REPLACE_openssl_rand_hex_32
COOKIE_SECRET=REPLACE_openssl_rand_hex_32

# ---- Admin ----
MEDUSA_ADMIN_PATH=/app
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# ---- Email (Resend) ----
# Leave blank to log emails instead of sending. Add key when ready.
RESEND_API_KEY=
EMAIL_FROM=orders@hopsandglory.au

# ---- Storage (S3-compatible) ----
# OCI Object Storage: endpoint is https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Leave blank to disable file uploads on staging.
S3_ENDPOINT=
S3_FILE_URL=
S3_REGION=ap-sydney-1
S3_BUCKET=hopsandglory-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Storefront ----
# Fill PUBLISHABLE_KEY after first boot (see setup instructions).
PUBLISHABLE_KEY=
STOREFRONT_IMAGE_HOSTS=

# ---- Shipping ----
SHIPENGINE_API_KEY=
SHIPENGINE_API_BASE=https://api.shipengine.com/v1
SHIPENGINE_CARRIER_IDS=se-5530570,se-5530571
AUSPOST_API_KEY=
AUSPOST_API_BASE=https://digitalapi.auspost.com.au

# ---- PayID ----
PAYID_ALIAS=payments@hopsandglory.au
PAYID_HOLD_HOURS=72

# ---- Observability (optional) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- OpenAI (optional) ----
OPENAI_API_KEY=
